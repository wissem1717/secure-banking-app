<!-- /views/clients/list.ejs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Liste des Clients</title>

  <!-- Lien vers le fichier CSS pour styliser la page -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Bandeau principal avec le titre et le bouton d'ajout -->
  <header>
    <h1>👥 Liste des Clients</h1>
    <a href="/clients/create" class="btn">➕ Ajouter un client</a>
  </header>

  <main>
    <% if (clients.length === 0) { %>
      <!-- S'il n'y a aucun client, on affiche un simple message -->
      <p>Aucun client trouvé pour le moment.</p>
    <% } else { %>
      <!-- Sinon, on construit un tableau avec tous les clients -->
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Date de Naissance</th>
            <th>Actions</th> <!-- Colonne pour les boutons -->
          </tr>
        </thead>

        <tbody>
          <% clients.forEach(client => { %>
            <tr>
              <td><%= client.id %></td>
              <td><%= client.first_name %></td>
              <td><%= client.last_name %></td>
              <td><%= client.date_of_birth.toISOString().split('T')[0] %></td>
              <td>
                <!-- Lien pour voir les détails du client -->
                <a href="/clients/<%= client.id %>" class="btn" aria-label="Voir détails client">
                  👁️ Voir
                </a>

                <!-- Lien pour modifier le client -->
                <a href="/clients/<%= client.id %>/edit" class="btn" aria-label="Modifier client">
                  ✏️ Modifier
                </a>

                <!-- Formulaire pour supprimer (soft delete) -->
                <form action="/clients/<%= client.id %>/delete" method="POST" style="display:inline;">
                  <button type="submit" class="btn" onclick="return confirm('Confirmer la suppression ?')" aria-label="Supprimer client">
                    🗑️ Supprimer
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </main>

</body>
</html>
