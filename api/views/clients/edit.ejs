<!-- 
Fichier : /views/clients/edit.ejs
Page : Formulaire de modification d'un client existant
-->

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Modifier un Client</title>

  <!-- Lien vers le style général -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- En-tête de la page -->
  <header>
    <h1>✏️ Modifier un Client</h1>
    <!-- Bouton de retour vers la liste des clients -->
    <a href="/clients" class="btn">⬅️ Retour à la liste</a>
  </header>

  <main>

    <!-- Formulaire de modification -->
    <!-- Attention : méthode POST envoyée à l'URL spécifique du client -->
    <form action="/clients/<%= client.id %>/edit" method="POST">

      <!-- Champ : Prénom -->
      <div class="form-group">
        <label for="first_name">Prénom :</label>
        <input 
          type="text" 
          id="first_name" 
          name="first_name" 
          value="<%= client.first_name %>" 
          required
          placeholder="Modifier le prénom">
      </div>

      <!-- Champ : Nom -->
      <div class="form-group">
        <label for="last_name">Nom :</label>
        <input 
          type="text" 
          id="last_name" 
          name="last_name" 
          value="<%= client.last_name %>" 
          required
          placeholder="Modifier le nom">
      </div>

      <!-- Champ : Date de naissance -->
      <div class="form-group">
        <label for="date_of_birth">Date de naissance :</label>
        <input 
          type="date" 
          id="date_of_birth" 
          name="date_of_birth" 
          value="<%= client.date_of_birth ? client.date_of_birth.toISOString().split('T')[0] : '' %>" 
          required>
      </div>

      <!-- Bouton de soumission -->
      <div class="form-group">
        <button type="submit" class="btn">💾 Sauvegarder</button>
      </div>

    </form>

  </main>

</body>
</html>
