<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Espace Clients - Banque</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 2rem;
      background-color: #f4f6f7;
    }

    h1 {
      color: #2c3e50;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 2rem;
    }

    table, th, td {
      border: 1px solid #ccc;
    }

    th, td {
      padding: 12px;
      text-align: left;
    }

    th {
      background-color: #2c3e50;
      color: white;
    }

    tr:nth-child(even) {
      background-color: #ecf0f1;
    }

    button {
      margin-top: 20px;
      margin-right: 10px;
      padding: 0.8rem 1.2rem;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      color: white;
      font-size: 1rem;
      cursor: pointer;
    }

    #logoutBtn { background-color: #e74c3c; }
    #logoutBtn:hover { background-color: #c0392b; }

    #exportBtn { background-color: #27ae60; }
    #exportBtn:hover { background-color: #1e8449; }

    #addBtn { background-color: #2980b9; }
    #addBtn:hover { background-color: #2471a3; }

    /* Popup */
    .popup {
      display: none;
      position: fixed;
      top: 20%;
      left: 50%;
      transform: translate(-50%, -20%);
      background-color: white;
      border: 1px solid #ccc;
      padding: 1.5rem;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
      z-index: 999;
      width: 350px;
      border-radius: 10px;
    }

    .popup input {
      width: 100%;
      margin-bottom: 10px;
      padding: 8px;
    }

    .popup h3 {
      margin-top: 0;
    }
  </style>
</head>
<body>

  <h1>Bienvenue <%= user.email %> !</h1>
  <p>Voici les données secrètes des clients 🔒</p>

  <table id="clientTable">
    <thead>
      <tr>
        <th>Numéro de compte</th>
        <th>Nom du client</th>
        <th>Solde (€)</th>
        <th>Type</th>
      </tr>
    </thead>
    <tbody id="clientBody">
      <tr>
        <td>FR761234598765</td>
        <td>Jean Dupont</td>
        <td>12,500.00</td>
        <td>Courant</td>
      </tr>
      <tr>
        <td>FR761234598766</td>
        <td>Lucie Martin</td>
        <td>8,320.45</td>
        <td>Épargne</td>
      </tr>
      <tr>
        <td>FR761234598767</td>
        <td>Sophie Bernard</td>
        <td>20,100.00</td>
        <td>Courant</td>
      </tr>
    </tbody>
  </table>

  <button id="exportBtn">⬇️ Exporter en CSV</button>
  <button id="addBtn">➕ Ajouter un client</button>
  <button id="logoutBtn">📕 Se déconnecter</button>

  <!-- ➕ FORM POPUP -->
  <div class="popup" id="popupForm">
    <h3>➕ Nouveau Client</h3>
    <input type="text" id="accountNumber" placeholder="Numéro de compte" required>
    <input type="text" id="clientName" placeholder="Nom du client" required>
    <input type="number" id="balance" placeholder="Solde" required>
    <input type="text" id="type" placeholder="Type (Courant / Épargne)" required>
    <button onclick="submitClient()">✅ Ajouter</button>
    <button onclick="closePopup()">❌ Annuler</button>
  </div>

  <script>
    // 🔐 Déconnexion
    document.getElementById("logoutBtn").addEventListener("click", () => {
      localStorage.removeItem("token");
      window.location.href = "/";
    });

    // 📥 Export CSV
    document.getElementById("exportBtn").addEventListener("click", () => {
      const rows = Array.from(document.querySelectorAll("table tr"));
      const csv = rows.map(row =>
        Array.from(row.children).map(cell => `"${cell.innerText}"`).join(",")
      ).join("\n");

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = "clients.csv";
      link.click();
    });

    // ➕ Popup open
    document.getElementById("addBtn").addEventListener("click", () => {
      document.getElementById("popupForm").style.display = "block";
    });

    function closePopup() {
      document.getElementById("popupForm").style.display = "none";
    }

    // ➕ Submit New Client
    function submitClient() {
      const account = document.getElementById("accountNumber").value;
      const name = document.getElementById("clientName").value;
      const balance = document.getElementById("balance").value;
      const type = document.getElementById("type").value;

      // 👉 Ajouter à la table HTML (simulation)
      const row = document.createElement("tr");
      row.innerHTML = `
        <td>${account}</td>
        <td>${name}</td>
        <td>${parseFloat(balance).toFixed(2)}</td>
        <td>${type}</td>
      `;
      document.getElementById("clientBody").appendChild(row);

      closePopup();
    }
  </script>

</body>
</html>











