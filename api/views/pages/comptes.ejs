<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Comptes - Banque App</title>
  <style>
    body {
      font-family: sans-serif;
      max-width: 800px;
      margin: 40px auto;
    }
    table, th, td {
      border: 1px solid #ccc;
      border-collapse: collapse;
      padding: 8px;
    }
    table {
      width: 100%;
      margin-bottom: 30px;
    }
    form {
      display: flex;
      gap: 10px;
    }
    input, select {
      padding: 5px;
      flex: 1;
    }
    button {
      padding: 5px 10px;
    }
  </style>
</head>
<body>
  <h1>Liste des comptes</h1>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Client</th>
        <th>Solde</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="comptesBody">
      <!-- Comptes AJAX ici -->
    </tbody>
  </table>

  <h2>Ajouter un compte</h2>
  <form id="addCompteForm">
    <input type="number" name="client_id" placeholder="ID client" required>
    <input type="number" step="0.01" name="solde" placeholder="Solde initial" required>
    <button type="submit">Ajouter</button>
  </form>

  <script>
    const token = localStorage.getItem("token");

    if (!token) {
      window.location.href = "/";
    }

    // 🔄 Charger les comptes
    fetch("/comptes/json", {
      headers: {
        "Authorization": "Bearer " + token
      }
    })
    .then(res => res.json())
    .then(comptes => {
      const tbody = document.getElementById("comptesBody");
      tbody.innerHTML = "";

      comptes.forEach(compte => {
        const row = document.createElement("tr");
        row.innerHTML = `
          <td>${compte.id}</td>
          <td>${compte.client_id}</td>
          <td>${compte.solde}</td>
          <td>
            <form onsubmit="deleteCompte(${compte.id}); return false;">
              <button>Supprimer</button>
            </form>
          </td>
        `;
        tbody.appendChild(row);
      });
    });

    // ➕ Ajouter compte
    const form = document.getElementById("addCompteForm");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const client_id = form.client_id.value;
      const solde = form.solde.value;

      const res = await fetch("/comptes", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": "Bearer " + token
        },
        body: JSON.stringify({ client_id, solde })
      });

      if (res.ok) location.reload();
    });

    // ❌ Supprimer compte
    async function deleteCompte(id) {
      const res = await fetch(`/comptes/delete/${id}`, {
        method: "POST",
        headers: {
          "Authorization": "Bearer " + token
        }
      });

      if (res.ok) location.reload();
    }
  </script>
</body>
</html>



